#!/bin/sh
if [ "$1" = "-V" ]; then
  echo "OpenSSH_9.6p1 Ubuntu-3ubuntu13.5, OpenSSL 3.0.13 30 Jan 2024" >&2
  exit 0
fi
if [ "$1" = "-G" ]; then
  if [ "$3" = "stg-broken" ]; then
    echo "Pseudo-terminal will not be allocated because stdin is not a terminal." >&2
    echo "/home/me/.ssh/config.d/10-staging.conf line 6: Bad configuration option: bogus" >&2
    echo "/home/me/.ssh/config: terminating, 1 bad configuration options" >&2
    exit 255
  fi
  echo "Pseudo-terminal will not be allocated because stdin is not a terminal." >&2
  printf 'host %s\nuser ubuntu\nhostname 192.0.2.11\nport 22\naddressfamily any\nproxyjump stg-bastion\n' "$3"
  exit 0
fi
if [ -t 0 ]; then
  if stty -a | grep -Eq '(^|[[:space:]])-(icanon|echo)([[:space:]]|$)'; then
    echo RAW >&2
  else
    echo COOKED >&2
  fi
fi
echo "ssh $*"
