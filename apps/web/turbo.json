{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/crates/sshpick/package.json",
        "$TURBO_ROOT$/crates/sshpick/tests/fixtures/ui/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**"]
    }
  }
}
