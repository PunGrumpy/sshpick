#!/bin/sh
# Stands in for a keyway that has --print but not `ls --recent`: the JSON usage error it writes
# for any `ls` that is given the option.
echo '{"status":"action_required","reason":"usage","message":"unknown option \"--recent\"","fix":"keyway list accepts --help, --json, --no-color, --non-interactive, --version."}' >&2
exit 2
