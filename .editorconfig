# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

[*.rs]
# Keep in sync with rustfmt
max_line_length = 100
indent_size = 4

# Fixtures are byte-exact inputs (CRLF, BOM, trailing spaces); editors must not "fix" them.
[crates/*/tests/fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
